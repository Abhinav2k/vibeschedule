<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- 1. Idle View: Shown when no schedule or timer is active (Only a ring symbol) -->
    <FrameLayout
        android:id="@+id/layout_widget_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="visible">

        <FrameLayout
            android:id="@+id/btn_widget_ring"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_btn_ring"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="Quick Timer"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_ring" />
        </FrameLayout>
    </FrameLayout>

    <!-- 2. Active View: Default view shown when schedule or timer is running (Skip & Cancel, no indicator) -->
    <LinearLayout
        android:id="@+id/layout_widget_active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- Button 1: Skip This Period -->
        <FrameLayout
            android:id="@+id/btn_widget_skip"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_btn_skip_minimal"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="Skip This Period"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_skip" />
        </FrameLayout>

        <!-- Button 2: Cancel Active Schedule / End Now -->
        <FrameLayout
            android:id="@+id/btn_widget_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="0dp"
            android:background="@drawable/widget_btn_cancel_minimal"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="Cancel Schedule"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_cancel" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
