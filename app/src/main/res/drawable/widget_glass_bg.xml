<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Gaussian Drop Shadow / Depth Occlusion -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#2E000000" />
        </shape>
    </item>

    <!-- Deep Diffused Glass Body (Soft blurred optical absorption) -->
    <item
        android:left="0.75dp"
        android:top="0.75dp"
        android:right="0.75dp"
        android:bottom="0.75dp">
        <shape android:shape="rectangle">
            <corners android:radius="27dp" />
            <gradient
                android:angle="270"
                android:startColor="#4D283248"
                android:centerColor="#38181F2E"
                android:endColor="#47101420" />
            <stroke
                android:width="1dp"
                android:color="#52FFFFFF" />
        </shape>
    </item>

    <!-- Prismatic Chromatic Dispersion / Diffraction Fringe (Iridescent rim) -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="16dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="26dp"
                android:topRightRadius="26dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <!-- Angle 45 creates a prismatic diagonal light sheen (violet -> cyan -> specular white) -->
            <gradient
                android:angle="45"
                android:startColor="#33AF52DE"
                android:centerColor="#59FFFFFF"
                android:endColor="#335AC8FA" />
        </shape>
    </item>

    <!-- Inner Refractive Light Diffusion (Simulating optical glass volume) -->
    <item
        android:left="1.5dp"
        android:top="1.5dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <gradient
                android:angle="270"
                android:startColor="#24FFFFFF"
                android:centerColor="#05FFFFFF"
                android:endColor="#0A000000" />
            <stroke
                android:width="0.5dp"
                android:color="#24FFFFFF" />
        </shape>
    </item>
</layer-list>
