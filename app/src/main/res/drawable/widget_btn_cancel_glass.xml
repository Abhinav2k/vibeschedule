<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state: bright glowing coral red glass -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#4DFF453A"
                android:endColor="#2EFF453A" />
            <stroke
                android:width="1.2dp"
                android:color="#99FF453A" />
        </shape>
    </item>
    <!-- Default state: frosted liquid glass with coral red tint -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#1EFF453A"
                        android:centerColor="#14181E28"
                        android:endColor="#0EFF453A" />
                    <stroke
                        android:width="0.85dp"
                        android:color="#38FF453A" />
                </shape>
            </item>
            <!-- Top specular reflection -->
            <item
                android:left="1dp"
                android:right="1dp"
                android:top="1dp"
                android:bottom="10dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="17dp"
                        android:topRightRadius="17dp"
                        android:bottomLeftRadius="0dp"
                        android:bottomRightRadius="0dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#25FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
