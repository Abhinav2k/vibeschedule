<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#59FF9F0A">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <!-- Pressed state: illuminated amber flare with glowing border -->
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#F2382612" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#B3FF9F0A" />
                </shape>
            </item>

            <!-- Default state: Opaque dark amber slate with transparent amber outline -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#F21E1710" />
                    <stroke
                        android:width="1.25dp"
                        android:color="#59FF9F0A" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
