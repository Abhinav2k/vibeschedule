<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33000000">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <!-- Pressed state: slightly darker off-white with distinct border -->
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#E0D8DCE2" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#4D000000" />
                </shape>
            </item>

            <!-- Default state: Premium porcelain white with subtle outline -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#F2F2F4F7" />
                    <stroke
                        android:width="1.25dp"
                        android:color="#26000000" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
