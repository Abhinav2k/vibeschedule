<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state: Brilliant illuminated round lens with radiant amber flare -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#66FF9F0A"
                        android:centerColor="#4DFF9F0A"
                        android:endColor="#33FF9F0A" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#E6FF9F0A" />
                </shape>
            </item>
            <!-- Convex lens specular highlight -->
            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="20dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#80FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default state: Round circular lens with diffraction edge & amber core -->
    <item>
        <layer-list>
            <!-- Lens outer body with prismatic diffraction stroke -->
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#3DFFFFFF"
                        android:centerColor="#26243044"
                        android:endColor="#1AFF9F0A" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#59FFFFFF" />
                </shape>
            </item>
            <!-- Internal radiant amber diffraction core -->
            <item
                android:left="1.5dp"
                android:top="1.5dp"
                android:right="1.5dp"
                android:bottom="1.5dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="45"
                        android:startColor="#1AFFD60A"
                        android:centerColor="#14FF9F0A"
                        android:endColor="#29FF9F0A" />
                    <stroke
                        android:width="0.75dp"
                        android:color="#4DFF9F0A" />
                </shape>
            </item>
            <!-- Top spherical glass lens reflection -->
            <item
                android:left="3dp"
                android:top="2dp"
                android:right="3dp"
                android:bottom="24dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#59FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
