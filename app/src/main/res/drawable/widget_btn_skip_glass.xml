<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state: vibrant illuminated amber glass lens -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#59FF9F0A"
                        android:centerColor="#3DFF9F0A"
                        android:endColor="#2BFF9F0A" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#CCFF9F0A" />
                </shape>
            </item>
            <item
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="12dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="19dp"
                        android:topRightRadius="19dp"
                        android:bottomLeftRadius="0dp"
                        android:bottomRightRadius="0dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#66FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default state: iPhone liquid frosted glass lens with luminous amber backlight -->
    <item>
        <layer-list>
            <!-- Frosted glass body -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#38FFFFFF"
                        android:centerColor="#202A384A"
                        android:endColor="#18FF9F0A" />
                    <stroke
                        android:width="1dp"
                        android:color="#52FFFFFF" />
                </shape>
            </item>
            <!-- Luminous amber internal refraction -->
            <item
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="19dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#1AFFFFFF"
                        android:centerColor="#0FFF9F0A"
                        android:endColor="#26FF9F0A" />
                    <stroke
                        android:width="0.5dp"
                        android:color="#40FF9F0A" />
                </shape>
            </item>
            <!-- Top specular glass sheen -->
            <item
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="14dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="19dp"
                        android:topRightRadius="19dp"
                        android:bottomLeftRadius="0dp"
                        android:bottomRightRadius="0dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#4DFFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
