<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4DFF453A">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <!-- Pressed state: highlighted red -->
            <item android:state_pressed="true">
                <shape android:shape="oval">
                    <solid android:color="#40FF453A" />
                    <stroke
                        android:width="2dp"
                        android:color="#CCFF453A" />
                </shape>
            </item>
            <!-- Default idle state: Dark crimson tint with luminous red border -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#2B1414" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#80FF453A" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
